# ===============================================
# CivicHelp AI — Express API Gateway Configuration
# ===============================================

# Server Port & Environment
PORT=5000
NODE_ENV=development

# Python FastAPI RAG Engine URL
FASTAPI_URL=http://localhost:8000

# AWS SDK v3 / S3-compatible LocalStack Configuration
# For local demonstration via LocalStack (Build It track):
# AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=civichelp-knowledge-vault-prod
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_ENDPOINT_URL=
